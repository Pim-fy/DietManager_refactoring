# 이 파일을 .env.local로 복사해 값을 넣는다. .env, .env.local은 Git에 올리지 않는다.
# 프론트 개발 서버가 /api 요청을 전달할 백엔드 주소. 비워두면 http://localhost:8080
VITE_API_PROXY_TARGET=

# Playwright E2E 고정 테스트 계정(npm run test:e2e). 이미 설정된 환경 변수가 이 파일 값보다 우선한다.
# 계정이 없으면 첫 실행 때 이 값으로 가입한다(생년월일 1990-01-01). 실제 사용 계정이 아닌 테스트 전용 이메일을 쓴다.
E2E_EMAIL=
# 8자 이상 64자 이하. 비밀번호 변경 테스트가 잠시 바꿨다가 이 값으로 되돌린다.
E2E_PASSWORD=
